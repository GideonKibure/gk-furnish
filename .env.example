# Copy this file to .env on your own machine. Never commit .env.
# Names only. Do not put real keys in this file.

# Which shop this process is: production, staging, or development.
# Server only. A development server warns when it is pointed at the live database.
APP_ENV=

# Public site origin used in links and the Snippe webhook URL. Server only.
# Leave empty to use https://gkfurnish.co.tz.
SITE_URL=

# Supabase. The URL and publishable key are also read in the browser as VITE_ copies.
# The service-role key is server only. Never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Live project URL (https://YOUR_PROJECT.supabase.co), not a key.
# Set this on every machine, including staging, so development can tell the live database from staging.
# Server only.
SUPABASE_PRODUCTION_URL=

# Snippe. Server only. Never prefix these with VITE_.
# Set SNIPPE_ENABLED to the word true before webhooks or the backup check may confirm a payment.
SNIPPE_ENABLED=
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_WEBHOOK_URL=

# PalmPesa, optional. Used only when PAYMENT_MODE is exactly palmpesa. Server only.
PAYMENT_MODE=
PALMPESA_API_TOKEN=
PALMPESA_SIGNING_SECRET=
PALMPESA_CALLBACK_URL=

# Protects GET /api/cron/palmpesa. Server only.
# If this is empty, that cron route does not check a secret.
CRON_SECRET=

# Mailjet. Server only.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=

# Optional Lovable cron secrets. Server only.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Browser only. Google Search Console verification token, not a secret API key.
VITE_GOOGLE_SITE_VERIFICATION=
